[Unit]
Description=Notebook Relay private tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=notebook-relay
Group=notebook-relay
LoadCredentialEncrypted=frpc.toml:/etc/credstore.encrypted/notebook-relay-frpc.toml
ExecStart=/opt/notebook-relay/runtime/frpc -c %d/frpc.toml
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
MemoryMax=256M
TasksMax=128

[Install]
WantedBy=multi-user.target
