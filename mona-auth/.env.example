MONA_AUTH_ENVIRONMENT=production
MONA_AUTH_DATABASE_URL=mysql+pymysql://mona:your_password@127.0.0.1:3306/mona_auth
MONA_AUTH_DATABASE_POOL_SIZE=5
MONA_AUTH_DATABASE_POOL_MAX_OVERFLOW=5
MONA_AUTH_JWT_ACCESS_SECRET=change-me-to-a-random-string
MONA_AUTH_MODEL_ACCESS_TOKEN_EXPIRE_MINUTES=15
MONA_AUTH_MODEL_ACCESS_ENABLED=false
MONA_AUTH_CREDITS_PAYMENT_ENABLED=false
MONA_AUTH_MODEL_ACCESS_MAX_OUTPUT_TOKENS=16384
MONA_AUTH_MODEL_ACCESS_MAX_REQUEST_BYTES=1000000
MONA_AUTH_MODEL_ACCESS_MAX_USER_CONCURRENCY=1
MONA_AUTH_MODEL_ACCESS_MAX_GLOBAL_CONCURRENCY=20
MONA_AUTH_MODEL_ACCESS_RESERVED_STALE_SECONDS=120
MONA_AUTH_MODEL_ACCESS_RUNNING_STALE_SECONDS=900
MONA_AUTH_ONE_API_BASE_URL=http://127.0.0.1:13000
MONA_AUTH_ONE_API_HEALTH_PATH=/api/status
MONA_AUTH_ONE_API_TOKEN=
MONA_AUTH_ONE_API_ADMIN_TOKEN=
MONA_AUTH_ONE_API_DATABASE_PATH=/opt/one-api/one-api.db
MONA_AUTH_LICENSE_PRIVATE_KEY_PATH=keys/private.pem
MONA_AUTH_LICENSE_PUBLIC_KEY_PATH=keys/public.pem
MONA_AUTH_LICENSE_EXPIRE_DAYS=7
MONA_AUTH_MAX_DEVICES_PER_USER=3
MONA_AUTH_XHP_APP_ID=your_xunhupay_app_id
MONA_AUTH_XHP_APP_SECRET=your_xunhupay_app_secret
MONA_AUTH_XHP_NOTIFY_URL=https://mona.example.com/payment/notify
MONA_AUTH_ALIPAY_APP_ID=
MONA_AUTH_ALIPAY_APP_PRIVATE_KEY_PATH=
MONA_AUTH_ALIPAY_PUBLIC_KEY_PATH=
MONA_AUTH_ALIPAY_SELLER_ID=
MONA_AUTH_ALIPAY_NOTIFY_URL=https://mona.example.com/payment/alipay/notify
MONA_AUTH_ALIPAY_RETURN_URL=https://mona.example.com/payment/return
MONA_AUTH_CORS_ORIGINS=["https://mona.example.com"]
MONA_AUTH_UPLOAD_DIR=/var/www/mona/uploads
MONA_AUTH_UPLOAD_URL_BASE=https://mona.example.com/uploads
MONA_AUTH_EXPERT_CATALOG_PATH=/var/www/mona/catalogs/experts/catalog-v1.json
MONA_AUTH_RUNTIME_CATALOG_PATH=/var/www/mona/catalogs/runtimes/catalog-v1.json
MONA_AUTH_WORKER_SHARED_KEY=
MONA_AUTH_WORKER_ATTACHMENT_DIR=/var/lib/mona/worker-attachments
MONA_AUTH_WORKER_ATTACHMENT_MAX_BYTES=104857600
MONA_AUTH_WORKER_JOB_LEASE_SECONDS=120
MONA_AUTH_WORKER_JOB_MAX_PAYLOAD_BYTES=65536
MONA_AUTH_WORKER_JOB_MAX_RESULT_BYTES=524288
