[Unit]
Description=Mona Auth Service
After=network-online.target mariadb.service
Wants=network-online.target

[Service]
User=mona
Group=mona
WorkingDirectory=/opt/mona-auth
ExecStart=/opt/mona-auth/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8901 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=5
EnvironmentFile=/opt/mona-auth/.env
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
LimitNOFILE=65535
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
