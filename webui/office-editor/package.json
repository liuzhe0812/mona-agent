{
  "name": "@mona/office-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mona's independently built Office editor entry points",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4178",
    "test": "node --test mona/entry-contract.test.mjs && vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "build:mona": "vite build --outDir ../../../mona/web/dist/office-editor --emptyOutDir",
    "build:tauri": "vite build --outDir ../../../src-tauri/dist/office-editor --emptyOutDir",
    "report:bundle-size": "node scripts/report-bundle-size.mjs",
    "generate:third-party-notices": "node scripts/generate-third-party-notices.mjs"
  },
  "dependencies": {
    "html-to-image": "^1.11.11",
    "@fluentui/react-icons": "2.0.333",
    "@tiptap/core": "3.31.3",
    "@tiptap/extensions": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@univerjs/core": "0.25.1",
    "@univerjs/data-validation": "0.25.1",
    "@univerjs/engine-render": "0.25.1",
    "@univerjs/find-replace": "0.25.1",
    "@univerjs/preset-sheets-conditional-formatting": "0.25.1",
    "@univerjs/preset-sheets-core": "0.25.1",
    "@univerjs/preset-sheets-data-validation": "0.25.1",
    "@univerjs/preset-sheets-drawing": "0.25.1",
    "@univerjs/preset-sheets-filter": "0.25.1",
    "@univerjs/preset-sheets-find-replace": "0.25.1",
    "@univerjs/preset-sheets-note": "0.25.1",
    "@univerjs/preset-sheets-sort": "0.25.1",
    "@univerjs/preset-sheets-table": "0.25.1",
    "@univerjs/sheets-filter": "0.25.1",
    "@univerjs/themes": "0.25.1",
    "acorn": "8.18.0",
    "bidi-js": "^1.0.3",
    "buffer": "6.0.3",
    "fast-xml-parser": "^5.3.4",
    "harfbuzzjs": "^1.4.0",
    "jszip": "^3.10.1",
    "konva": "9.3.20",
    "opentype.js": "^2.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-konva": "19.0.10",
    "rxjs": "7.8.2",
    "utif2": "^4.1.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.6",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^4.1.0"
  }
}
