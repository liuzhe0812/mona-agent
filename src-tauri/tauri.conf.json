{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Mona",
  "version": "0.1.0",
  "identifier": "com.mona.desktop",
  "build": {
    "beforeDevCommand": "cd ../webui && npm run build:tauri",
    "beforeBuildCommand": "cd ../webui && npm run build:tauri",
    "frontendDist": "../src-tauri/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mona",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "Mona"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*"
    ]
  }
}
