{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "Mona",
  "version": "0.1.0",
  "identifier": "com.mona.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev",
      "cwd": "../webui"
    },
    "beforeBuildCommand": {
      "script": "npm run build:tauri",
      "cwd": "../webui"
    },
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "./dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mona",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*"
    ]
  }
}
