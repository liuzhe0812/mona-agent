+  .suggestions-header .account-topbar { padding: 14px 20px; }
+  .suggestions-main { width: min(100% - 32px, 1000px); padding-top: 40px; }
+  .suggestions-intro { margin-bottom: 36px; }
+  .suggestions-item { padding: 20px; }
+  .suggestions-item p { margin-left: 0; }
+  .suggestions-fab { right: 12px; bottom: calc(12px + env(safe-area-inset-bottom)); }
+  .suggestions-composer { width: calc(100% - 24px); bottom: calc(12px + env(safe-area-inset-bottom) + var(--suggestions-keyboard-offset, 0px)); max-height: calc(var(--suggestions-viewport-height, 100dvh) - 24px - env(safe-area-inset-bottom)); padding: 16px; }
