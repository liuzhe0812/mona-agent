diff --git a/official-site/app/suggestions/page.tsx b/official-site/app/suggestions/page.tsx
new file mode 100644
--- /dev/null
+++ b/official-site/app/suggestions/page.tsx
@@ -0,0 +1,280 @@
+"use client";
+
+import { useEffect, useRef, useState, type FormEvent } from "react";
+import { MonaWordmark } from "../brand-wordmark";
+import { AccountFeedback } from "../account/AccountFeedback";
+import { AccountNav } from "../account/AccountNav";
+import { clearSession, readSession, type AccountSession } from "../account/client";
+import "./suggestions.css";
+
+type Suggestion = { id: string; body: string; display_name: string; created_at: string };
+type Draft = { body: string; requestId: string | null };
+type ListReply = { items: Suggestion[]; next_before: string | null };
+
+const draftKey = (accountId: string) => `mona-suggestion-draft-v2:${accountId}`;
+const emptyDraft: Draft = { body: "", requestId: null };
+const emoji = ["😊", "💡", "👍", "🎉", "❤️", "🙏"];
+
+function initialDraft(accountId: string): Draft {
+  try {
+    const draft = JSON.parse(sessionStorage.getItem(draftKey(accountId)) || "null");
+    if (typeof draft?.body === "string" && (draft.requestId === null || typeof draft.requestId === "string")) return draft;
+  } catch { /* A blocked or invalid draft does not prevent reading suggestions. */ }
+  return emptyDraft;
+}
+
+function formatDate(value: string) {
+  const date = new Date(value);
+  return Number.isNaN(date.getTime()) ? "" : new Intl.DateTimeFormat("zh-CN", { year: "numeric", month: "long", day: "numeric" }).format(date);
+}
+
+export default function SuggestionsPage() {
+  const [session, setSession] = useState<AccountSession | null>(null);
+  const [sessionState, setSessionState] = useState<"checking" | "guest" | "ready" | "unavailable">("checking");
+  const [draft, setDraft] = useState<Draft>(emptyDraft);
+  const [items, setItems] = useState<Suggestion[]>([]);
+  const [nextBefore, setNextBefore] = useState<string | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [listError, setListError] = useState("");
+  const [sending, setSending] = useState(false);
+  const [fieldError, setFieldError] = useState("");
+  const [error, setError] = useState("");
+  const [notice, setNotice] = useState("");
+  const [draftStored, setDraftStored] = useState(true);
+  const [composerOpen, setComposerOpen] = useState(false);
+  const textarea = useRef<HTMLTextAreaElement>(null);
+  const composer = useRef<HTMLElement>(null);
+  const writeButton = useRef<HTMLButtonElement>(null);
+  const activeSession = useRef<AccountSession | null>(null);
+  const sessionRevision = useRef(0);
+  const refreshSession = useRef<() => void>(() => {});
+
+  useEffect(() => {
+    let mounted = true;
+    let controller: AbortController | null = null;
+    const refresh = () => {
+      const candidate = readSession();
+      const revision = ++sessionRevision.current;
+      controller?.abort();
+      controller = new AbortController();
+      activeSession.current = null;
+      setSession(null); setDraft(emptyDraft); setFieldError(""); setError(""); setNotice(""); setSending(false); setDraftStored(true);
+      if (!candidate) { setSessionState("guest"); return; }
+      setSessionState("checking");
+      void fetch("/auth/identity", { headers: { Accept: "application/json", Authorization: `Bearer ${candidate.token}` },
+        credentials: "omit", cache: "no-store", redirect: "error", signal: controller.signal }).then(async response => {
+        if (!mounted || revision !== sessionRevision.current) return;
+        const current = readSession();
+        if (current?.token !== candidate.token || current.user.id !== candidate.user.id) { refresh(); return; }
+        if (response.status === 401) {
+          clearSession(candidate.token);
+          setError("登录状态已失效，请重新登录后继续。你的建议草稿会保留。");
+          return;
+        }
+        if (!response.ok || !response.headers.get("Content-Type")?.toLowerCase().startsWith("application/json")) throw new Error();
+        const identity = await response.json();
+        if (!mounted || revision !== sessionRevision.current) return;
+        const latest = readSession();
+        if (latest?.token !== candidate.token || latest.user.id !== candidate.user.id) { refresh(); return; }
+        if (identity?.account_id !== candidate.user.id) {
+          clearSession(candidate.token);
+          setError("登录状态无法确认，请重新登录后继续。");
+          return;
+        }
+        activeSession.current = candidate;
+        setDraft(initialDraft(identity.account_id)); setSession(candidate); setSessionState("ready");
+      }).catch(() => {
+        if (mounted && revision === sessionRevision.current) setSessionState("unavailable");
+      });
+    };
+    refreshSession.current = refresh;
+    refresh();
+    window.addEventListener("mona-account-changed", refresh);
+    window.addEventListener("pageshow", refresh);
+    return () => {
+      mounted = false; ++sessionRevision.current; controller?.abort(); activeSession.current = null;
+      window.removeEventListener("mona-account-changed", refresh); window.removeEventListener("pageshow", refresh);
+    };
+  }, []);
+
+  async function load(before: string | null = null, signal?: AbortSignal) {
+    setLoading(true); setListError("");
+    try {
+      const query = before ? `?before=${encodeURIComponent(before)}` : "";
+      const response = await fetch(`/api/suggestions${query}`, { headers: { Accept: "application/json" }, credentials: "omit", cache: "no-store", redirect: "error", signal });
+      if (!response.ok || !response.headers.get("Content-Type")?.toLowerCase().startsWith("application/json")) throw new Error();
+      const value: ListReply = await response.json();
+      if (!Array.isArray(value?.items) || (value.next_before !== null && typeof value.next_before !== "string")) throw new Error();
+      if (signal?.aborted) return;
+      setItems(current => before ? [...current, ...value.items.filter(item => !current.some(existing => existing.id === item.id))]
+        : [...current.filter(item => !value.items.some(fetched => fetched.id === item.id)), ...value.items]);
+      setNextBefore(value.next_before);
+    } catch {
+      if (!signal?.aborted) setListError("暂时无法加载建议，请稍后重试。");
+    } finally {
+      if (!signal?.aborted) setLoading(false);
+    }
+  }
+
+  useEffect(() => {
+    const controller = new AbortController();
+    void load(null, controller.signal);
+    return () => controller.abort();
+  }, []);
+
+  useEffect(() => {
+    if (composerOpen && session) textarea.current?.focus();
+  }, [composerOpen, session?.token]);
+
+  useEffect(() => {
+    if (!composerOpen) return;
+    const viewport = window.visualViewport;
+    const panel = composer.current;
+    const shell = panel?.closest<HTMLElement>(".suggestions-shell");
+    const update = () => {
+      const height = viewport?.height ?? window.innerHeight;
+      const offset = Math.max(0, window.innerHeight - height - (viewport?.offsetTop ?? 0));
+      panel?.style.setProperty("--suggestions-keyboard-offset", `${offset}px`);
+      panel?.style.setProperty("--suggestions-viewport-height", `${height}px`);
+      if (panel) shell?.style.setProperty("--suggestions-composer-space", `${offset + panel.getBoundingClientRect().height + 48}px`);
+    };
+    update();
+    const observer = new ResizeObserver(update);
+    if (panel) observer.observe(panel);
+    viewport?.addEventListener("resize", update); viewport?.addEventListener("scroll", update);
+    window.addEventListener("resize", update);
+    return () => { observer.disconnect(); shell?.style.removeProperty("--suggestions-composer-space"); viewport?.removeEventListener("resize", update); viewport?.removeEventListener("scroll", update); window.removeEventListener("resize", update); };
+  }, [composerOpen]);
+
+  function closeComposer() {
+    if (sending) return;
+    setComposerOpen(false);
+    requestAnimationFrame(() => writeButton.current?.focus());
+  }
+
+  useEffect(() => {
+    if (!composerOpen) return;
+    const onKey = (event: KeyboardEvent) => {
+      if (event.key !== "Escape" || sending || document.querySelector("dialog[open], .account-menu[open]")) return;
+      event.preventDefault(); closeComposer();
+    };
+    document.addEventListener("keydown", onKey);
+    return () => document.removeEventListener("keydown", onKey);
+  }, [composerOpen, sending]);
+
+  function saveDraft(accountId: string, value: Draft) {
+    setDraft(value);
+    try {
+      if (value.body || value.requestId) sessionStorage.setItem(draftKey(accountId), JSON.stringify(value));
+      else sessionStorage.removeItem(draftKey(accountId));
+      setDraftStored(true);
+    } catch { setDraftStored(false); }
+  }
+
+  function changeBody(body: string) {
+    if (!session || activeSession.current?.token !== session.token) return;
+    saveDraft(session.user.id, { body, requestId: body === draft.body ? draft.requestId : null });
+    setFieldError(""); setNotice("");
+  }
+
+  function insertEmoji(value: string) {
+    const input = textarea.current;
+    if (!input) return;
+    const start = input.selectionStart, end = input.selectionEnd;
+    changeBody(draft.body.slice(0, start) + value + draft.body.slice(end));
+    requestAnimationFrame(() => { input.focus(); input.setSelectionRange(start + value.length, start + value.length); });
+  }
+
+  async function submit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    if (!session || sending || activeSession.current?.token !== session.token) return;
+    const revision = sessionRevision.current;
+    const stillCurrent = () => {
+      const current = readSession();
+      return revision === sessionRevision.current && activeSession.current?.token === session.token
+        && current?.token === session.token && current.user.id === session.user.id;
+    };
+    if (!stillCurrent()) return;
+    const body = draft.body.trim();
+    if (!body || Array.from(body).length > 1000) {
+      setFieldError(body ? "建议请控制在 1000 字以内。" : "请先填写建议。" );
+      textarea.current?.focus();
+      return;
+    }
+    const requestId = draft.requestId || crypto.randomUUID();
+    saveDraft(session.user.id, { ...draft, requestId });
+    setFieldError(""); setNotice(""); setSending(true);
+    try {
+      const response = await fetch("/api/suggestions", { method: "POST", credentials: "omit", cache: "no-store", redirect: "error",
+        headers: { Accept: "application/json", "Content-Type": "application/json", Authorization: `Bearer ${session.token}` },
+        body: JSON.stringify({ body, request_id: requestId }) });
+      if (!response.headers.get("Content-Type")?.toLowerCase().startsWith("application/json")) throw new Error("提交结果未确认，请保留内容并重试。");
+      const value = await response.json();
+      if (!stillCurrent()) return;
+      if (!response.ok) {
+        if (response.status === 401) {
+          clearSession(session.token);
+          setError("登录状态已失效，请重新登录后继续。你的建议草稿会保留。");
+        } else if (response.status === 422) setFieldError(typeof value?.message === "string" ? value.message : "请检查建议内容后重试。");
+        else setError(typeof value?.message === "string" ? value.message : response.status === 429 ? "提交过于频繁，请稍后再试。" : "提交未完成，请稍后重试。");
+        return;
+      }
+      if (typeof value?.id !== "string" || typeof value?.body !== "string" || typeof value?.display_name !== "string" || typeof value?.created_at !== "string") throw new Error("提交结果未确认，请保留内容并重试。");
+      setItems(current => [value, ...current.filter(item => item.id !== value.id)]);
+      saveDraft(session.user.id, emptyDraft);
+      setNotice("建议已发布，谢谢你的分享。");
+      setComposerOpen(false);
+      requestAnimationFrame(() => writeButton.current?.focus());
+    } catch (value) {
+      if (stillCurrent()) setError(value instanceof Error && value.message === "提交结果未确认，请保留内容并重试。" ? value.message : "连接中断，提交结果未确认。请保留内容并重试。");
+    } finally { if (stillCurrent()) setSending(false); }
+  }
+
+  const count = Array.from(draft.body).length;
+  return <div className={`account-shell suggestions-shell${composerOpen ? " is-composing" : ""}`}>
+    <div className="suggestions-header"><header className="account-topbar">
+      <a className="account-brand" href="/" aria-label="Mona 首页"><img src="/img/mona-brand/mona-app-icon.png?v=a829e97b8751" alt="" /><MonaWordmark /></a>
+      <div className="account-topbar-actions"><a className="account-back" href="/">返回官网</a><AccountNav disabled={sending} /></div>
+    </header></div>
+    <main className="suggestions-main">
+      <section className="suggestions-intro" aria-labelledby="suggestions-title">
+        <p className="suggestions-kicker">MONA / PRODUCT IDEAS</p>
+        <h1 id="suggestions-title">给Mona的建议</h1>
+        <p>有什么想法，告诉我们。一起让 Mona 变得更好。</p>
+      </section>
+      {notice && <p className="suggestions-notice" role="status">{notice}</p>}
+      <section className="suggestions-list" aria-labelledby="suggestions-list-title">
+        <h2 id="suggestions-list-title">大家的建议</h2>
+        {items.length > 0 && <ol>{items.map(item => <li className="suggestions-item" key={item.id}>
+          <div className="suggestions-item-meta"><span className="suggestions-avatar" aria-hidden="true">{Array.from(item.display_name)[0]?.toUpperCase()}</span><strong>{item.display_name}</strong><time dateTime={item.created_at}>{formatDate(item.created_at)}</time></div>
+          <p>{item.body}</p>
+        </li>)}</ol>}
+        {loading && <p className="account-help" role="status">正在加载建议…</p>}
+        {!loading && listError && <div className="suggestions-list-status"><p className="account-help">{listError}</p><button className="account-link" type="button" onClick={() => void load(items.length ? nextBefore : null)}>重新加载</button></div>}
+        {!loading && !listError && !items.length && <p className="suggestions-empty account-help">还没有建议，欢迎分享第一个想法。</p>}
+        {!loading && !listError && nextBefore && <button className="account-button suggestions-more" type="button" onClick={() => void load(nextBefore)}>查看更多</button>}
+      </section>
+    </main>
+    <button ref={writeButton} className="suggestions-fab" type="button" aria-label="写建议" aria-expanded={composerOpen}
+      aria-controls="suggestions-composer" hidden={composerOpen} onClick={() => setComposerOpen(true)}>
+      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m5 19 3.5-.7L19 7.8 16.2 5 5.7 15.5 5 19Z"/><path d="m14.9 6.3 2.8 2.8"/></svg>
+    </button>
+    {composerOpen && <section ref={composer} className="suggestions-composer" id="suggestions-composer" aria-labelledby="suggestions-compose-title">
+      <div className="suggestions-compose-head"><div><h2 id="suggestions-compose-title">分享你的建议</h2>
+        <p className="account-help">发布后所有人可见，请勿填写个人隐私。</p></div>
+        <button className="suggestions-close" type="button" aria-label="收起建议输入框" disabled={sending} onClick={closeComposer}>×</button></div>
+      {session ? <form onSubmit={event => void submit(event)}>
+        <label className="account-field" htmlFor="suggestion-body"><span className="suggestions-visually-hidden">建议内容</span>
+          <textarea id="suggestion-body" ref={textarea} rows={3} value={draft.body} onChange={event => changeBody(event.target.value)} disabled={sending}
+            placeholder="你希望 Mona 做得更好的地方…" aria-invalid={Boolean(fieldError)} aria-describedby={fieldError ? "suggestion-hint suggestion-error" : "suggestion-hint"} /></label>
+        <div className="suggestions-compose-meta"><div className="suggestions-emoji" aria-label="插入表情">{emoji.map(value => <button key={value} type="button" disabled={sending} onClick={() => insertEmoji(value)} aria-label={`插入表情 ${value}`}>{value}</button>)}</div><span id="suggestion-hint">{count} / 1000</span></div>
+        {fieldError && <p className="account-field-error" id="suggestion-error" role="alert">{fieldError}</p>}
+        {!draftStored && <p className="account-help">草稿仅保留在当前页面，离开后会清除。</p>}
+        <div className="suggestions-submit"><button className="account-button primary" type="submit" disabled={sending}>{sending ? "正在发布…" : "发布建议"}</button></div>
+      </form> : sessionState === "checking" ? <div className="suggestions-signin"><p className="account-help" role="status">正在确认登录状态…</p></div>
+        : sessionState === "unavailable" ? <div className="suggestions-signin"><p className="account-help">暂时无法确认登录状态，请稍后重试。</p><button className="account-button" type="button" onClick={() => refreshSession.current()}>重新尝试</button></div>
+          : <div className="suggestions-signin"><p className="account-help">登录后即可分享你的建议。</p><a className="account-button primary" href="/account">登录 / 注册</a></div>}
+    </section>}
+    {error && <AccountFeedback message={error} close={() => setError("")} />}
+  </div>;
+}
diff --git a/official-site/app/suggestions/suggestions.css b/official-site/app/suggestions/suggestions.css
new file mode 100644
--- /dev/null
+++ b/official-site/app/suggestions/suggestions.css
@@ -0,0 +1,70 @@
+.suggestions-shell {
+  --suggestions-muted: color-mix(in srgb, var(--ink) 65%, transparent);
+  --suggestions-line: color-mix(in srgb, var(--ink) 14%, transparent);
+  --suggestions-surface: color-mix(in srgb, var(--paper) 96%, var(--ink));
+  --suggestions-hover: color-mix(in srgb, var(--paper) 90%, var(--ink));
+  background: radial-gradient(ellipse at 86% 0%, color-mix(in srgb, var(--red) 5%, transparent), transparent 48%), var(--paper);
+  color: var(--ink);
+}
+.suggestions-header { background: var(--ink); color: var(--paper); }
+.suggestions-header .account-topbar { padding: 16px 24px; border-bottom: 0; }
+.suggestions-main, .suggestions-composer {
+  --account-muted: var(--suggestions-muted);
+  --account-line: var(--suggestions-line);
+  --account-surface: var(--suggestions-surface);
+  --account-hover: var(--suggestions-hover);
+}
+.suggestions-main { width: min(100% - 48px, 1000px); margin: 0 auto; padding: 64px 0 120px; }
+.suggestions-shell.is-composing .suggestions-main { padding-bottom: var(--suggestions-composer-space, 420px); }
+.suggestions-intro { margin-bottom: 48px; }
+.suggestions-kicker { margin: 0 0 14px; color: var(--red); font-size: 13px; font-weight: 700; letter-spacing: .08em; }
+.suggestions-intro h1 { margin: 0 0 12px; font-size: clamp(32px, 4vw, 48px); line-height: 1.3; letter-spacing: -.03em; }
+.suggestions-intro > p:last-child { margin: 0; color: var(--suggestions-muted); font-size: 16px; line-height: 1.8; }
+.suggestions-notice { margin: 0 0 24px; padding: 12px 16px; border-left: 3px solid var(--red); border-radius: 8px; background: color-mix(in srgb, var(--red) 7%, var(--paper)); font-size: 14px; }
+.suggestions-list h2 { display: flex; align-items: center; gap: 10px; margin: 0 0 20px; font-size: 16px; }
+.suggestions-list h2::before { width: 8px; height: 8px; flex: none; border-radius: 50%; background: var(--red); content: ""; }
+.suggestions-list ol { display: grid; gap: 12px; list-style: none; margin: 0; padding: 0; }
+.suggestions-item { padding: 24px; border: 1px solid var(--suggestions-line); border-radius: 12px; background: var(--suggestions-surface); }
+.suggestions-item-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; font-size: 14px; }
+.suggestions-avatar { display: grid; place-items: center; width: 36px; height: 36px; flex: none; border-radius: 50%; background: color-mix(in srgb, var(--ink) 8%, var(--paper)); color: var(--ink); font-weight: 700; }
+.suggestions-item-meta strong { min-width: 0; overflow-wrap: anywhere; }
+.suggestions-item-meta time { margin-left: auto; color: var(--suggestions-muted); font-size: 13px; }
+.suggestions-item p { margin: 14px 0 0 48px; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 16px; line-height: 1.8; }
+.suggestions-empty, .suggestions-list-status { padding: 36px 24px; border: 1px dashed var(--suggestions-line); border-radius: 12px; color: var(--suggestions-muted); }
+.suggestions-list-status { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; }
+.suggestions-more { margin-top: 16px; }
+.suggestions-main .account-button, .suggestions-composer .account-button:not(.primary) { border-color: var(--suggestions-line); color: var(--ink); }
+.suggestions-main .account-button:hover:not(:disabled), .suggestions-composer .account-button:not(.primary):hover:not(:disabled) { background: var(--suggestions-hover); }
+.suggestions-fab { position: fixed; right: 24px; bottom: calc(24px + env(safe-area-inset-bottom)); z-index: 120; display: grid; place-items: center; width: 56px; height: 56px; padding: 0; border: 0; border-radius: 50%; background: var(--red); color: var(--paper); box-shadow: 0 12px 30px color-mix(in srgb, var(--ink) 24%, transparent); cursor: pointer; }
+.suggestions-fab:hover { box-shadow: 0 12px 30px color-mix(in srgb, var(--ink) 32%, transparent); }
+.suggestions-fab svg { width: 24px; height: 24px; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
+.suggestions-composer { position: fixed; z-index: 120; left: 50%; bottom: calc(24px + var(--suggestions-keyboard-offset, 0px)); transform: translateX(-50%); width: min(820px, calc(100% - 48px)); max-height: calc(var(--suggestions-viewport-height, 100dvh) - 48px); overflow-y: auto; overscroll-behavior: contain; padding: 20px 24px; border: 1px solid var(--suggestions-line); border-radius: 16px; background: var(--paper); color: var(--ink); box-shadow: 0 16px 48px color-mix(in srgb, var(--ink) 24%, transparent); }
+.suggestions-compose-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; }
+.suggestions-compose-head h2 { margin: 0 0 4px; font-size: 16px; }
+.suggestions-close { display: grid; place-items: center; width: 44px; height: 44px; flex: none; margin: -8px -8px 0 0; padding: 0; border: 0; border-radius: 8px; background: transparent; color: var(--ink); font-size: 24px; cursor: pointer; }
+.suggestions-close:hover:not(:disabled) { background: var(--suggestions-hover); }
+.suggestions-close:disabled { color: var(--suggestions-muted); cursor: wait; }
+.suggestions-composer form { margin-top: 12px; }
+.suggestions-composer textarea { width: 100%; min-height: 84px; max-height: min(220px, 30vh); padding: 12px; resize: vertical; overflow-y: auto; border: 1px solid var(--suggestions-line); border-radius: 8px; background: var(--suggestions-surface); color: var(--ink); font: inherit; line-height: 1.6; }
+.suggestions-composer textarea::placeholder { color: var(--suggestions-muted); opacity: 1; }
+.suggestions-composer textarea[aria-invalid="true"] { border-color: var(--red); }
+.suggestions-compose-meta { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 6px 0; color: var(--suggestions-muted); font-size: 13px; }
+.suggestions-compose-meta > span { flex-shrink: 0; white-space: nowrap; }
+.suggestions-emoji { display: flex; flex-wrap: wrap; gap: 4px; }
+.suggestions-emoji button { min-width: 36px; min-height: 36px; padding: 4px; border: 0; border-radius: 8px; background: transparent; cursor: pointer; font-size: 18px; }
+.suggestions-emoji button:hover:not(:disabled) { background: var(--suggestions-hover); }
+.suggestions-emoji button:disabled { cursor: wait; }
+.suggestions-composer .account-field-error { margin: 4px 0; }
+.suggestions-submit { display: flex; justify-content: flex-end; margin-top: 8px; }
+.suggestions-signin { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-top: 16px; }
+.suggestions-visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
+.suggestions-main :is(a, button):focus-visible, .suggestions-composer :is(a, button, textarea):focus-visible, .suggestions-shell .suggestions-fab:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
