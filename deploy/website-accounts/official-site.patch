+++ b/official-site/app/account/AccountFeedback.tsx
@@ -0,0 +1,12 @@
+"use client";
+import { useEffect, useId, useRef } from "react";
+
+export function AccountFeedback({ message, close }: { message: string; close: () => void }) {
+  const dialog = useRef<HTMLDialogElement>(null);
+  const title = useId();
+  useEffect(() => { if (message && !dialog.current?.open) dialog.current?.showModal(); }, [message]);
+  return <dialog className="account-feedback" ref={dialog} onClose={close} aria-labelledby={title}>
+    <h2 id={title}>操作未完成</h2><p>{message}</p>
+    <button className="account-button primary" autoFocus onClick={() => dialog.current?.close()}>知道了</button>
+  </dialog>;
+}
diff --git a/official-site/app/account/AccountNav.tsx b/official-site/app/account/AccountNav.tsx
new file mode 100644
--- /dev/null
+++ b/official-site/app/account/AccountNav.tsx
@@ -0,0 +1,73 @@
+"use client";
+import { useEffect, useRef, useState } from "react";
+import { AccountError, logout, readSession, type AccountSession } from "./client";
+import { AccountFeedback } from "./AccountFeedback";
+import "./account.css";
+
+export function AccountNav({ disabled = false }: { disabled?: boolean }) {
+  const [session, setSession] = useState<AccountSession | null>(null);
+  const [open, setOpen] = useState(false);
+  const [workReady, setWorkReady] = useState<boolean | null>(null);
+  const [busy, setBusy] = useState(false);
+  const [error, setError] = useState("");
+  const menu = useRef<HTMLDetailsElement>(null);
+  useEffect(() => {
+    const refresh = () => setSession(readSession());
+    refresh();
+    window.addEventListener("mona-account-changed", refresh);
+    window.addEventListener("pageshow", refresh);
+    return () => { window.removeEventListener("mona-account-changed", refresh); window.removeEventListener("pageshow", refresh); };
+  }, []);
+  useEffect(() => {
+    if (menu.current) menu.current.open = false;
+    setOpen(false); setWorkReady(null);
+  }, [session?.token]);
+  useEffect(() => {
+    if (!open || !session) return;
+    const controller = new AbortController();
+    setWorkReady(null);
+    void fetch("/api/work/models", { headers: { Authorization: `Bearer ${session.token}`, Accept: "application/json" },
+      credentials: "omit", cache: "no-store", redirect: "error", signal: controller.signal }).then(async response => {
+      if (!response.ok || !response.headers.get("Content-Type")?.startsWith("application/json")) return false;
+      const value = await response.json();
+      return Array.isArray(value?.models) && value.models.length > 0;
+    }).then(value => { if (!controller.signal.aborted) setWorkReady(value); }).catch(() => {
+      if (!controller.signal.aborted) setWorkReady(false);
+    });
+    return () => controller.abort();
+  }, [open, session]);
+  useEffect(() => {
+    if (!open) return;
+    const outside = (event: PointerEvent) => { if (!menu.current?.contains(event.target as Node) && menu.current) menu.current.open = false; };
+    const escape = (event: KeyboardEvent) => {
+      if (event.key === "Escape" && menu.current) { menu.current.open = false; menu.current.querySelector("summary")?.focus(); }
+    };
+    document.addEventListener("pointerdown", outside);
+    document.addEventListener("keydown", escape);
+    return () => { document.removeEventListener("pointerdown", outside); document.removeEventListener("keydown", escape); };
+  }, [open]);
+  if (!session) return <a className="account-nav-entry account-nav-login nav-link" href="/account" aria-label="登录或注册"><span className="nav-link-label">登录 / 注册</span></a>;
+  const name = session.user.display_name || "Mona 账号";
+  return <>
+    <details className="account-menu" ref={menu} onToggle={event => setOpen(event.currentTarget.open)}>
+      <summary className="account-nav-entry" aria-label={`${name}，账户菜单`} aria-expanded={open}>
+        <span className="account-nav-avatar" aria-hidden="true">{name.slice(0, 1).toUpperCase()}</span>
+        <span className="account-nav-name">{name}</span>
+        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" /></svg>
+      </summary>
+      <div className="account-menu-panel" aria-label="账户菜单">
+        <a href="/account">账户设置</a>
+        {workReady ? <a href="/work/">进入在线 Work</a>
+          : <span className="account-menu-unavailable">{workReady === null ? "正在检查在线 Work…" : "在线 Work 暂未开放"}</span>}
+        <button disabled={busy || disabled} onClick={async () => {
+          if (busy || disabled) return;
+          setBusy(true);
+          try { await logout(session.token); }
+          catch (value) { setError(value instanceof AccountError ? value.message : "退出未能确认，请稍后重试。"); }
+          finally { setBusy(false); }
+        }}>{busy ? "正在退出…" : "退出登录"}</button>
+      </div>
+    </details>
+    {error && <AccountFeedback message={error} close={() => setError("")} />}
+  </>;
+}
