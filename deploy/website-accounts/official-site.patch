+  }, []);
+  const run: Run = useCallback(async task => {
+    if (mutation.current) return;
+    mutation.current = true; setBusy(true); setNotice("");
+    try { await task(); } catch (value) { report(value); }
+    finally { mutation.current = false; setBusy(false); }
+  }, [report]);
+  const authenticated = useCallback((reply: LoginReply) => {
+    setSession(acceptLogin(reply)); setBinding(null); setMode("login");
+    if (window.location.pathname.endsWith("/wechat")) window.history.replaceState({}, "", "/account");
+  }, []);
+
+  useEffect(() => {
+    const controller = new AbortController(); setLoadError(false);
+    const stored = readSession();
+    if (stored) setSession(stored);
+    void accountRequest<Capabilities>("capabilities", { signal: controller.signal }).then(setCapabilities).catch(value => {
+      if (!controller.signal.aborted) { setLoadError(true); report(value); }
+    });
+    if (stored) void accountRequest<AccountProfile>("profile", { token: stored.token, signal: controller.signal }).then(user => {
+      if (!controller.signal.aborted) { const next = { ...stored, user }; saveSession(next); setSession(next); }
+    }).catch(value => {
+      if (!controller.signal.aborted) {
+        if (value instanceof AccountError && value.status === 401) { clearSession(stored.token); setSession(null); }
