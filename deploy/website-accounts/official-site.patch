+"use client";
+import { useEffect, useState } from "react";
+import { readSession } from "./client";
+import "./account.css";
+
+export function AccountNav() {
+  const [name, setName] = useState("");
+  useEffect(() => {
+    const refresh = () => setName(readSession()?.user.display_name || "");
+    refresh();
+    window.addEventListener("mona-account-changed", refresh);
+    window.addEventListener("pageshow", refresh);
+    return () => { window.removeEventListener("mona-account-changed", refresh); window.removeEventListener("pageshow", refresh); };
+  }, []);
+  return <a className="account-nav-entry" href="/account" aria-label={name ? "账户信息" : "登录或注册"}><span>{name || "登录 / 注册"}</span></a>;
+}
