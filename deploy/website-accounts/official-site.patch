+++ b/official-site/app/account/page.tsx
@@ -0,0 +1,268 @@
+"use client";
+import { useCallback, useEffect, useRef, useState, type FormEvent } from "react";
+import { AccountError, accountRequest, acceptLogin, beginWeChat, clearSession, clearWeChatProof,
+  logout, readSession, readWeChatProof, saveSession, type AccountProfile, type AccountSession,
+  type Capabilities, type EmailProof, type LoginReply, type WeChatProof } from "./client";
+import "./account.css";
+
+type Mode = "login" | "register" | "reset";
+type Run = (task: () => Promise<void>) => Promise<void>;
+const blankProof = (): EmailProof => ({ email: "", challenge_id: "", code: "" });
+
+function Feedback({ message, close }: { message: string; close: () => void }) {
+  const dialog = useRef<HTMLDialogElement>(null);
+  useEffect(() => { if (message && !dialog.current?.open) dialog.current?.showModal(); }, [message]);
+  return <dialog className="account-feedback" ref={dialog} onClose={close} aria-labelledby="account-error-title">
+    <h2 id="account-error-title">操作未完成</h2><p>{message}</p>
+    <button className="account-button primary" autoFocus onClick={() => dialog.current?.close()}>知道了</button>
+  </dialog>;
+}
+
+function EmailVerification({ value, update, request, busy, run }: {
+  value: EmailProof; update: (value: EmailProof) => void; request: (email: string) => Promise<{ challenge_id: string; resend_after_seconds: number }>;
+  busy: boolean; run: Run;
+}) {
+  const [seconds, setSeconds] = useState(0);
+  const input = useRef<HTMLInputElement>(null);
+  useEffect(() => {
+    if (seconds <= 0) return;
+    const timer = setTimeout(() => setSeconds(previous => Math.max(previous - 1, 0)), 1000);
+    return () => clearTimeout(timer);
+  }, [seconds]);
+  return <>
+    <label className="account-field">邮箱<input ref={input} type="email" autoComplete="email" required maxLength={255}
+      value={value.email} disabled={busy} onChange={event => update({ email: event.target.value, challenge_id: "", code: "" })} /></label>
+    <div className="account-code"><label className="account-field">邮箱验证码<input inputMode="numeric" autoComplete="one-time-code" required
+      pattern="[0-9]{6}" minLength={6} maxLength={6} disabled={busy} value={value.code}
+      onChange={event => update({ ...value, code: event.target.value.replace(/\D/g, "").slice(0, 6) })} /></label>
+      <button className="account-button" type="button" disabled={busy || seconds > 0} onClick={() => {
+        if (!input.current?.reportValidity()) return;
+        void run(async () => {
+          const email = value.email.trim().toLowerCase();
+          const reply = await request(email);
+          update({ email, challenge_id: reply.challenge_id, code: "" });
+          setSeconds(Math.min(Math.max(reply.resend_after_seconds, 1), 300));
+        });
+      }}>{seconds > 0 ? `${seconds} 秒后重发` : "获取验证码"}</button></div>
+    {value.challenge_id && <p className="account-help" role="status">验证码已发送，请检查收件箱和垃圾邮件。</p>}
+  </>;
+}
+
+function AuthForm({ mode, changeMode, busy, run, capabilities, authenticated, recovered, initialEmail }: {
+  mode: Mode; changeMode: (mode: Mode) => void; busy: boolean; run: Run; capabilities: Capabilities | null;
+  authenticated: (value: LoginReply) => void; recovered: () => void; initialEmail: string;
+}) {
+  const [account, setAccount] = useState(initialEmail);
+  const [proof, setProof] = useState<EmailProof>(() => ({ ...blankProof(), email: initialEmail }));
+  const [password, setPassword] = useState("");
+  const [name, setName] = useState("");
+  const enabled = Boolean(capabilities?.enabled && (mode === "login" || capabilities.email_registration));
+  async function submit(event: FormEvent) {
+    event.preventDefault();
+    await run(async () => {
+      if (mode === "login") {
+        const reply = await accountRequest<LoginReply>("login", { method: "POST", body: { account: account.trim(), password } });
+        authenticated(reply);
+      } else {
+        if (!proof.challenge_id) throw new AccountError("请先获取并填写邮箱验证码。", 400, "code_required");
+        if (new TextEncoder().encode(password).length > 72) throw new AccountError("密码过长，请控制在 72 个英文字符或 24 个中文字符以内。", 400);
+        if (mode === "register") {
+          authenticated(await accountRequest<LoginReply>("register", { method: "POST", body: { ...proof, password, display_name: name.trim() } }));
+        } else {
+          await accountRequest("reset-password", { method: "POST", body: { ...proof, password } });
+          recovered();
+        }
+      }
+      setPassword("");
+    });
+  }
+  return <>
+    {mode !== "reset" ? <div className="account-tabs" role="tablist" aria-label="登录方式">
+      <button role="tab" aria-selected={mode === "login"} disabled={busy} onClick={() => changeMode("login")}>登录</button>
+      <button role="tab" aria-selected={mode === "register"} disabled={busy} onClick={() => changeMode("register")}>邮箱注册</button>
+    </div> : <h2>重设密码</h2>}
+    <form className="account-form" onSubmit={submit}><fieldset disabled={busy || !enabled}>
+      {mode === "login" ? <label className="account-field">邮箱或账号<input required maxLength={255} autoComplete="username" value={account} onChange={event => setAccount(event.target.value)} /></label>
+        : <EmailVerification value={proof} update={setProof} busy={busy || !enabled} run={run}
+          request={email => accountRequest(mode === "register" ? "register-code" : "reset-code", { method: "POST", body: { email } })} />}
+      {mode === "register" && <label className="account-field">昵称<input required minLength={1} maxLength={64} autoComplete="nickname" value={name} onChange={event => setName(event.target.value)} /></label>}
+      <label className="account-field">{mode === "reset" ? "新密码" : "密码"}<input type="password" required minLength={mode === "login" ? 1 : 8}
+        maxLength={mode === "login" ? 128 : 72} autoComplete={mode === "login" ? "current-password" : "new-password"} value={password} onChange={event => setPassword(event.target.value)} /></label>
+      {mode !== "login" && <p className="account-help">至少 8 位。请勿使用其他网站的相同密码。</p>}
+      <button className="account-button primary" type="submit">{busy ? "正在处理…" : mode === "login" ? "登录" : mode === "register" ? "注册并登录" : "保存新密码"}</button>
+    </fieldset></form>
+    <div className="account-inline" style={{ marginTop: 18 }}>
+      <button className="account-link" disabled={busy} onClick={() => changeMode(mode === "reset" ? "login" : "reset")}>{mode === "reset" ? "返回登录" : "忘记密码？"}</button>
+      {mode !== "reset" && <span className="account-help">与 Mona 客户端共用账号</span>}
+    </div>
+    {capabilities && !enabled && <p className="account-help" style={{ marginTop: 18 }}>{capabilities.enabled ? "邮件验证暂未开放，已有账号仍可登录。" : "账号服务尚未开放，请稍后再试。"}</p>}
+    {mode !== "reset" && <div className="account-provider">
+      <button className="account-button" disabled={busy || !capabilities?.wechat_login} onClick={() => void run(beginWeChat)}>
+        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M10 3C5.6 3 2 5.7 2 9c0 1.9 1.1 3.6 2.8 4.7L4 16l3-1.5c.9.3 1.9.5 3 .5 4.4 0 8-2.7 8-6s-3.6-6-8-6Zm-3 5a1 1 0 1 1 0-2 1 1 0 0 1 0 2Zm6 0a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"/><path d="M18.8 9.1c.1.3.2.6.2.9 0 3.6-3.6 6.5-8.2 6.9C12 18.2 13.9 19 16 19c.8 0 1.7-.1 2.4-.4l2.6 1.3-.7-2c1.1-.9 1.7-2 1.7-3.4 0-2.3-1.2-4.3-3.2-5.4Z"/></svg>
+        微信扫码登录</button>
+      <p className="account-help">{capabilities?.wechat_login ? "首次扫码后验证并绑定邮箱，之后可直接扫码登录。" : "微信登录尚未开放，可先使用邮箱登录。"}</p>
+    </div>}
+  </>;
+}
+
+function WeChatBinding({ proof: wechat, suggestedName, busy, run, authenticated, cancel }: {
+  proof: WeChatProof; suggestedName: string; busy: boolean; run: Run; authenticated: (reply: LoginReply) => void; cancel: () => void;
+}) {
+  const [mode, setMode] = useState<"new" | "existing">("new");
+  const [emailProof, setEmailProof] = useState<EmailProof>(blankProof);
+  const [password, setPassword] = useState("");
+  const [name, setName] = useState(suggestedName);
+  const identity = { state: wechat.state, verifier: wechat.verifier };
+  return <><h2>绑定邮箱</h2><p className="account-help" style={{ marginBottom: 20 }}>微信身份已验证。绑定邮箱后完成登录；已有 Mona 账号可在这里关联，不会新建重复账号。</p>
+    <form className="account-form" onSubmit={event => { event.preventDefault(); void run(async () => {
+      if (!emailProof.challenge_id) throw new AccountError("请先获取邮箱验证码。", 400);
+      const reply = await accountRequest<LoginReply>("wechat/bind", { method: "POST", body: { ...identity, ...emailProof, mode, password, display_name: name.trim() } });
+      clearWeChatProof(); authenticated(reply);
+    }); }}><fieldset disabled={busy}>
+      <div className="account-radio"><label><input type="radio" checked={mode === "new"} onChange={() => setMode("new")} />新账号</label>
+        <label><input type="radio" checked={mode === "existing"} onChange={() => setMode("existing")} />绑定已有账号</label></div>
+      <EmailVerification value={emailProof} update={setEmailProof} busy={busy} run={run}
+        request={email => accountRequest("wechat/email-code", { method: "POST", body: { ...identity, email } })} />
+      {mode === "new" && <label className="account-field">昵称<input maxLength={64} value={name} onChange={event => setName(event.target.value)} /></label>}
+      <label className="account-field">{mode === "new" ? "设置登录密码" : "已有账号密码"}<input type="password" required minLength={8} maxLength={72} autoComplete={mode === "new" ? "new-password" : "current-password"} value={password} onChange={event => setPassword(event.target.value)} /></label>
+      <button className="account-button primary" type="submit">{busy ? "正在绑定…" : "验证并完成登录"}</button>
+      <button className="account-link" type="button" onClick={cancel}>取消并返回登录</button>
+    </fieldset></form></>;
+}
+
+function Profile({ session, busy, run, updated, signedOut, resetPassword, capabilities }: {
