+++ b/official-site/app/account/page.tsx
@@ -0,0 +1,327 @@
+"use client";
+import { useCallback, useEffect, useId, useRef, useState, type FormEvent } from "react";
+import { MonaWordmark } from "../brand-wordmark";
+import { AccountFeedback } from "./AccountFeedback";
+import { AccountNav } from "./AccountNav";
+import { AccountError, accountRequest, acceptLogin, beginWeChat, clearSession, clearWeChatProof,
+  readSession, readWeChatProof, saveSession, type AccountProfile, type AccountSession,
+  type Capabilities, type EmailProof, type LoginReply, type WeChatProof } from "./client";
+import "./account.css";
+
+type Mode = "login" | "register" | "reset";
