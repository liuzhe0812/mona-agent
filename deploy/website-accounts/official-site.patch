+    <a className="account-brand" href="/"><img src="/img/mona-brand/mona-app-icon.png?v=a829e97b8751" alt="" />MONA</a>
+    <a className="account-back" href="/">返回官网 ↗</a></header>
+    <main className="account-layout"><section className="account-intro"><span className="account-kicker">MONA ACCOUNT</span>
+      <h1>{session ? "你的 MONA，\n与你保持连接。" : "一个账号，\n开始你的工作。"}</h1>
+      <p>用邮箱或微信登录 Mona。官网与客户端共用账号，你的在线工作区依然独立、安全。</p></section>
+      <section className="account-panel" aria-label="Mona 账号">
+        {!ready ? <p role="status">正在读取登录状态…</p> : binding ? <WeChatBinding proof={binding.proof} suggestedName={binding.name} busy={busy} run={run} authenticated={authenticated} cancel={cancelBinding} />
+          : session && mode !== "reset" ? <Profile key={session.token + session.user.email} session={session} busy={busy} run={run} updated={updated} capabilities={capabilities}
+            signedOut={() => { setSession(null); setNotice("已安全退出登录。"); }} resetPassword={() => setMode("reset")} />
+          : <AuthForm key={mode} mode={mode} changeMode={setMode} busy={busy} run={run} capabilities={capabilities} authenticated={authenticated}
