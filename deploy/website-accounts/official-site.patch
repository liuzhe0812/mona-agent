diff --git a/official-site/app/account/client.ts b/official-site/app/account/client.ts
new file mode 100644
--- /dev/null
+++ b/official-site/app/account/client.ts
@@ -0,0 +1,102 @@
+export type AccountProfile = { id: string; email: string; account: string | null; display_name: string; wechat_bound: boolean };
+export type AccountSession = { token: string; user: AccountProfile };
+export type LoginReply = { access_token: string; user: AccountProfile; expires_in_seconds: number };
+export type Capabilities = { enabled: boolean; email_registration: boolean; wechat_login: boolean };
+export type EmailProof = { email: string; challenge_id: string; code: string };
+export type WeChatProof = { state: string; verifier: string; expiresAt: number };
+export const ACCOUNT_SESSION_KEY = "mona-website-session-v1";
+const OAUTH_KEY = "mona-website-wechat-v1";
+
+export class AccountError extends Error {
+  constructor(message: string, readonly status = 0, readonly code = "network_error") { super(message); }
+}
+
+export async function accountRequest<T>(route: string, options: { method?: string; body?: unknown; token?: string; signal?: AbortSignal } = {}): Promise<T> {
+  const headers = new Headers({ Accept: "application/json" });
+  if (options.body !== undefined) headers.set("Content-Type", "application/json");
+  if (options.token) headers.set("Authorization", `Bearer ${options.token}`);
+  let response: Response;
+  try {
+    response = await fetch(`/auth/web/${route}`, { method: options.method || "GET", headers, credentials: "omit",
+      cache: "no-store", redirect: "error", signal: options.signal,
+      ...(options.body !== undefined ? { body: JSON.stringify(options.body) } : {}) });
+  } catch (error) {
+    if (error instanceof DOMException && error.name === "AbortError") throw error;
+    throw new AccountError("连接中断，操作结果未确认。请检查账户状态后重试，不要重复提交。");
+  }
+  if (!response.headers.get("Content-Type")?.toLowerCase().startsWith("application/json")) {
+    throw new AccountError("账号服务暂不可用，请稍后重试。", 503, "service_unavailable");
+  }
+  const value = await response.json();
+  if (!response.ok) {
+    const fallback = response.status === 422 ? "请检查表单内容后重试。" : response.status === 429 ? "操作过于频繁，请稍后再试。" : "操作未完成，请稍后重试。";
+    throw new AccountError(typeof value?.message === "string" ? value.message : fallback, response.status,
+      typeof value?.error === "string" ? value.error : "request_failed");
+  }
+  return value as T;
+}
+
+export function readSession(): AccountSession | null {
+  if (typeof window === "undefined") return null;
+  try {
+    const value = JSON.parse(sessionStorage.getItem(ACCOUNT_SESSION_KEY) || "null");
+    return typeof value?.token === "string" && value.token.length > 0 && typeof value?.user?.id === "string" ? value : null;
+  } catch { return null; }
+}
+
+export function saveSession(value: AccountSession) {
+  try { sessionStorage.setItem(ACCOUNT_SESSION_KEY, JSON.stringify(value)); }
+  catch { throw new AccountError("浏览器无法保存登录状态，请允许此网站使用会话存储后重试。"); }
+  window.dispatchEvent(new Event("mona-account-changed"));
+}
+
+export function clearSession(token?: string) {
+  const current = readSession();
+  if (!token || current?.token === token) sessionStorage.removeItem(ACCOUNT_SESSION_KEY);
+  try {
+    const work = JSON.parse(sessionStorage.getItem("mona-hosted-work-v1") || "null");
+    if (!token || work?.token === token) sessionStorage.removeItem("mona-hosted-work-v1");
+  } catch { /* No valid Work login is available to remove. */ }
+  sessionStorage.removeItem(OAUTH_KEY);
+  window.dispatchEvent(new Event("mona-account-changed"));
+}
+
+export function acceptLogin(reply: LoginReply): AccountSession {
+  if (!reply || typeof reply.access_token !== "string" || !reply.access_token || typeof reply.user?.id !== "string") {
+    throw new AccountError("登录结果未能验证，请重新登录。", 503, "invalid_login");
+  }
+  const value = { token: reply.access_token, user: reply.user };
+  saveSession(value);
+  return value;
+}
+
+export async function logout(token: string): Promise<void> {
+  try { await accountRequest("logout", { method: "POST", token, body: {} }); }
+  catch (error) { if (!(error instanceof AccountError) || error.status !== 401) throw error; }
+  clearSession(token);
+}
+
+export async function beginWeChat(): Promise<void> {
+  const verifier = Array.from(crypto.getRandomValues(new Uint8Array(32)), value => value.toString(16).padStart(2, "0")).join("");
+  const reply = await accountRequest<{ state: string; authorization_url: string; expires_in_seconds: number }>("wechat/start", {
+    method: "POST", body: { verifier },
+  });
+  const target = new URL(reply.authorization_url);
+  if (!Number.isFinite(reply.expires_in_seconds) || reply.expires_in_seconds <= 0 || !/^[a-f0-9]{64}$/.test(reply.state) || target.origin !== "https://open.weixin.qq.com" || target.pathname !== "/connect/qrconnect"
+      || target.searchParams.get("state") !== reply.state || target.searchParams.get("scope") !== "snsapi_login"
+      || target.searchParams.get("redirect_uri") !== `${window.location.origin}/account/wechat`) {
+    throw new AccountError("微信授权地址未通过校验，请联系管理员。", 503, "invalid_oauth_url");
+  }
+  sessionStorage.setItem(OAUTH_KEY, JSON.stringify({ state: reply.state, verifier, expiresAt: Date.now() + Math.min(reply.expires_in_seconds, 600) * 1000 }));
+  window.location.assign(target.href);
+}
+
+export function readWeChatProof(): WeChatProof | null {
+  try {
+    const value = JSON.parse(sessionStorage.getItem(OAUTH_KEY) || "null");
+    if (/^[a-f0-9]{64}$/.test(value?.state) && /^[a-f0-9]{64}$/.test(value?.verifier) && value.expiresAt > Date.now()) return value;
+  } catch { /* A corrupt or expired attempt requires a new scan. */ }
+  return null;
+}
+
+export function clearWeChatProof() { sessionStorage.removeItem(OAUTH_KEY); }
