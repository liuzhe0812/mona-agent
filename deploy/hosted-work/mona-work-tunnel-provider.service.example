[Unit]
Description=Mona Work dedicated tunnel provider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus
ExecStart=/usr/bin/python3 /home/liuzhe/mona-hosted-work/tunnel-v1/tunnel.py provider
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
