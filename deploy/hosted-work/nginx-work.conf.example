# Include these locations inside the existing mona-ai.cn HTTPS server.
# The HTTP-context zones in nginx-work-limits.conf.example must be installed first.

location = /work {
    if ($host = www.mona-ai.cn) { return 308 https://mona-ai.cn/work/$is_args$args; }
    return 308 /work/$is_args$args;
}

location ^~ /work/ {
    if ($host = www.mona-ai.cn) { return 308 https://mona-ai.cn$request_uri; }
    limit_req zone=mona_work_requests burst=30 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:18801;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;
    proxy_buffering off;
    proxy_cache off;
}

location ^~ /api/work/ {
    if ($host = www.mona-ai.cn) { return 308 https://mona-ai.cn$request_uri; }
    limit_req zone=mona_work_requests burst=30 nodelay;
    limit_req_status 429;
    client_max_body_size 11m;
    proxy_pass http://127.0.0.1:18801;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-store" always;
    access_log off;
}

location = /api/work/auth/login {
    if ($host = www.mona-ai.cn) { return 308 https://mona-ai.cn$request_uri; }
    limit_req zone=mona_work_requests burst=30 nodelay;
    limit_req zone=mona_work_login burst=5 nodelay;
    limit_req_status 429;
    client_max_body_size 8k;
    proxy_pass http://127.0.0.1:18801;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header Origin $http_origin;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 180s;
    proxy_send_timeout 180s;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_cache off;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-store" always;
    access_log off;
}
