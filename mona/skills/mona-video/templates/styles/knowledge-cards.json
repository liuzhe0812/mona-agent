{
  "schemaVersion": 1,
  "id": "knowledge-cards",
  "name": "清晰教学",
  "description": "浅色背景、清楚的步骤和内容分组，适合教程与知识讲解。",
  "baseTemplateId": "knowledge-cards",
  "mode": "light",
  "tokens": {
    "colors": {
      "primary": "#315F9A",
      "secondary": "#5B6F86",
      "accent": "#315F9A",
      "background": "#F5F7FA",
      "surface": "#FFFFFF",
      "textPrimary": "#243243",
      "textSecondary": "#546171",
      "border": "#D7DEE7",
      "success": "#2A978C",
      "warning": "#F2B83F",
      "error": "#D94B41"
    },
    "typography": {
      "headingFamily": "Noto Sans SC",
      "bodyFamily": "Noto Sans SC",
      "scale": "standard",
      "headingWeight": 700,
      "bodyWeight": 400,
      "headingLineHeight": 1.15,
      "bodyLineHeight": 1.6
    },
    "shape": {
      "cardRadius": 8,
      "cardStyle": "solid",
      "density": "standard",
      "shadow": "none",
      "borderWidth": 1,
      "shadowOpacity": 0
    },
    "spacing": {
      "unit": 8,
      "contentPadding": 56
    }
  },
  "components": {
    "cover": "cover-card-stack-v1",
    "chapter": "chapter-sticker-v1",
    "content": "content-card-grid-v1",
    "data": "data-pill-row-v1",
    "comparison": "comparison-card-pair-v1",
    "process": "process-step-cards-v1",
    "quote": "quote-bubble-v1",
    "outro": "outro-card-v1"
  },
  "allowedLayouts": [
    "cover-card-stack",
    "chapter-sticker",
    "content-card-grid",
    "data-pill-row",
    "comparison-card-pair",
    "process-step-cards",
    "quote-bubble",
    "outro-card"
  ],
  "allowedAnimations": ["fade-rise", "stagger-rise", "cross-fade"],
  "motion": {
    "intensity": "restrained",
    "enterPreset": "fade-rise",
    "emphasisPreset": "fade-rise",
    "transitionPreset": "cross-fade",
    "enterDurationMs": 420,
    "staggerMs": 0,
    "transitionDurationMs": 420
  },
  "backgrounds": {
    "default": {
      "assetPolicy": "none",
      "fit": "cover",
      "focalPoint": {"x": 0.5, "y": 0.5},
      "overlay": {"type": "solid", "color": "#F5F7FA", "opacity": 0.9, "direction": "none"},
      "blur": 0,
      "tint": 0,
      "contrastMode": "auto",
      "safeArea": {"top": 0.08, "right": 0.08, "bottom": 0.1, "left": 0.08},
      "fallback": "#F5F7FA"
    },
    "roles": {
      "cover": {"inherit": "default"},
      "chapter": {"inherit": "default"},
      "content": {"inherit": "default", "assetPolicy": "episode-replaceable"},
      "data": {"inherit": "default"},
      "comparison": {"inherit": "default"},
      "process": {"inherit": "default"},
      "quote": {"inherit": "default"},
      "outro": {"inherit": "default"}
    }
  },
  "subtitle": {"position": "bottom-center", "style": "caption-rail", "fontSize": 36, "lineHeight": 1.35, "safeAreaBottom": 0.08, "maxLines": 2},
  "aspectVariants": {
    "16:9": {"enabled": true},
    "9:16": {"enabled": true},
    "1:1": {"enabled": true}
  }
}
