{
  "schemaVersion": 1,
  "id": "huashu-keynote",
  "name": "光影发布",
  "description": "深色光影、清晰大字和半透明卡片，适合产品介绍与功能展示。",
  "baseTemplateId": "huashu-keynote",
  "mode": "dark",
  "tokens": {
    "colors": {
      "primary": "#3D6BFF",
      "secondary": "#B8BDC9",
      "accent": "#3D6BFF",
      "background": "#050508",
      "surface": "#161521",
      "textPrimary": "#F6F6FA",
      "textSecondary": "#B8BDC9",
      "border": "#B8BDC9",
      "success": "#2B6B54",
      "warning": "#C69A4B",
      "error": "#A62920"
    },
    "typography": {
      "headingFamily": "Inter",
      "bodyFamily": "Noto Sans SC",
      "scale": "large",
      "headingWeight": 700,
      "bodyWeight": 400,
      "headingLineHeight": 1.2,
      "bodyLineHeight": 1.55
    },
    "shape": {
      "cardRadius": 20,
      "cardStyle": "glass",
      "density": "spacious",
      "shadow": "none",
      "borderWidth": 1,
      "shadowOpacity": 0
    },
    "spacing": {
      "unit": 8,
      "contentPadding": 80
    }
  },
  "components": {
    "cover": "cover-title-right-v1",
    "chapter": "chapter-numbered-v1",
    "content": "content-outline-v1",
    "data": "data-metric-row-v1",
    "comparison": "comparison-columns-v1",
    "process": "process-horizontal-v1",
    "quote": "quote-accent-v1",
    "outro": "outro-brand-light-v1"
  },
  "allowedLayouts": [
    "cover-title-right",
    "chapter-numbered",
    "content-outline",
    "data-metric-row",
    "comparison-columns",
    "process-horizontal",
    "quote-accent",
    "outro-brand"
  ],
  "allowedAnimations": [
    "fade-rise",
    "stagger-rise",
    "cross-fade"
  ],
  "motion": {
    "intensity": "standard",
    "enterPreset": "fade-rise",
    "emphasisPreset": "fade-rise",
    "transitionPreset": "cross-fade",
    "enterDurationMs": 520,
    "staggerMs": 90,
    "transitionDurationMs": 420
  },
  "backgrounds": {
    "default": {
      "assetPolicy": "none",
      "fit": "cover",
      "focalPoint": {
        "x": 0.5,
        "y": 0.5
      },
      "overlay": {
        "type": "solid",
        "color": "#050508",
        "opacity": 0.92,
        "direction": "none"
      },
      "blur": 0,
      "tint": 0,
      "contrastMode": "auto",
      "safeArea": {
        "top": 0.08,
        "right": 0.08,
        "bottom": 0.1,
        "left": 0.08
      },
      "fallback": "#050508"
    },
    "roles": {
      "cover": {
        "inherit": "default"
      },
      "chapter": {
        "inherit": "default"
      },
      "content": {
        "inherit": "default",
        "assetPolicy": "episode-replaceable"
      },
      "data": {
        "inherit": "default"
      },
      "comparison": {
        "inherit": "default"
      },
      "process": {
        "inherit": "default"
      },
      "quote": {
        "inherit": "default"
      },
      "outro": {
        "inherit": "default"
      }
    }
  },
  "subtitle": {
    "position": "bottom-center",
    "style": "caption-rail",
    "fontSize": 36,
    "lineHeight": 1.35,
    "safeAreaBottom": 0.08,
    "maxLines": 2
  },
  "aspectVariants": {
    "16:9": {
      "enabled": true
    },
    "9:16": {
      "enabled": true
    },
    "1:1": {
      "enabled": true
    }
  },
  "source": {
    "kind": "huashu-motion",
    "version": "0.3.1",
    "template": "keynote-ui",
    "templatePath": "assets/huashu-motion/templates/keynote-ui/index.html",
    "manifestPath": "assets/huashu-motion/templates/keynote-ui/template.json"
  }
}
