{
  "schemaVersion": 1,
  "id": "editorial-magazine",
  "name": "编辑排版",
  "description": "简洁纸白底色、清晰文字层级与单一红色重点，适合案例和故事讲解。",
  "baseTemplateId": "editorial-magazine",
  "mode": "dark",
  "tokens": {
    "colors": {
      "primary": "#A93A25",
      "secondary": "#6B645D",
      "accent": "#A93A25",
      "background": "#F6F5F2",
      "surface": "#FFFFFF",
      "textPrimary": "#1D1C1A",
      "textSecondary": "#57534E",
      "border": "#DFDAD3",
      "success": "#5E8A67",
      "warning": "#D39A2C",
      "error": "#E54B16"
    },
    "typography": {
      "headingFamily": "Noto Sans SC",
      "bodyFamily": "Noto Serif SC",
      "scale": "standard",
      "headingWeight": 700,
      "bodyWeight": 400,
      "headingLineHeight": 1.15,
      "bodyLineHeight": 1.6
    },
    "shape": {
      "cardRadius": 4,
      "cardStyle": "solid",
      "density": "spacious",
      "shadow": "none",
      "borderWidth": 1,
      "shadowOpacity": 0
    },
    "spacing": {
      "unit": 8,
      "contentPadding": 80
    }
  },
  "components": {
    "cover": "cover-editorial-masthead-v1",
    "chapter": "chapter-rule-v1",
    "content": "content-column-v1",
    "data": "data-editorial-stat-v1",
    "comparison": "comparison-ledger-v1",
    "process": "process-numbered-v1",
    "quote": "quote-pull-v1",
    "outro": "outro-editorial-v1"
  },
  "allowedLayouts": [
    "cover-editorial-masthead",
    "chapter-rule",
    "content-column",
    "data-editorial-stat",
    "comparison-ledger",
    "process-numbered",
    "quote-pull",
    "outro-editorial"
  ],
  "allowedAnimations": ["fade-rise", "stagger-rise", "cross-fade"],
  "motion": {
    "intensity": "restrained",
    "enterPreset": "fade-rise",
    "emphasisPreset": "fade-rise",
    "transitionPreset": "cross-fade",
    "enterDurationMs": 420,
    "staggerMs": 0,
    "transitionDurationMs": 420
  },
  "backgrounds": {
    "default": {
      "assetPolicy": "none",
      "fit": "cover",
      "focalPoint": {"x": 0.5, "y": 0.5},
      "overlay": {"type": "solid", "color": "#F6F5F2", "opacity": 0.92, "direction": "none"},
      "blur": 0,
      "tint": 0,
      "contrastMode": "auto",
      "safeArea": {"top": 0.1, "right": 0.1, "bottom": 0.12, "left": 0.1},
      "fallback": "#F6F5F2"
    },
    "roles": {
      "cover": {"inherit": "default"},
      "chapter": {"inherit": "default"},
      "content": {"inherit": "default", "assetPolicy": "episode-replaceable"},
      "data": {"inherit": "default"},
      "comparison": {"inherit": "default"},
      "process": {"inherit": "default"},
      "quote": {"inherit": "default"},
      "outro": {"inherit": "default"}
    }
  },
  "subtitle": {"position": "bottom-center", "style": "caption-rail", "fontSize": 36, "lineHeight": 1.35, "safeAreaBottom": 0.08, "maxLines": 2},
  "aspectVariants": {
    "16:9": {"enabled": true},
    "9:16": {"enabled": true},
    "1:1": {"enabled": true}
  }
}
