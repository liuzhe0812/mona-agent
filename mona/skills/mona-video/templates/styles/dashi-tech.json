{
  "schemaVersion": 1,
  "id": "dashi-tech",
  "name": "黑底科技",
  "description": "深色背景、暖金线条与米白文字，适合科技原理和趋势讲解。",
  "baseTemplateId": "dashi-tech",
  "mode": "dark",
  "tokens": {
    "colors": {
      "primary": "#e5cf95",
      "secondary": "#8c877b",
      "accent": "#b1312a",
      "background": "#090d13",
      "surface": "#1a1713",
      "textPrimary": "#f1efe4",
      "textSecondary": "#8c877b",
      "border": "#373334",
      "success": "#44E0B6",
      "warning": "#FFC857",
      "error": "#FF6B9A"
    },
    "typography": {
      "headingFamily": "Source Han Serif SC",
      "bodyFamily": "Source Han Serif SC",
      "scale": "standard",
      "headingWeight": 700,
      "bodyWeight": 400,
      "headingLineHeight": 1.15,
      "bodyLineHeight": 1.5
    },
    "shape": {
      "cardRadius": 8,
      "cardStyle": "glass",
      "density": "spacious",
      "shadow": "none",
      "borderWidth": 1,
      "shadowOpacity": 0
    },
    "spacing": {
      "unit": 8,
      "contentPadding": 72
    }
  },
  "components": {
    "cover": "cover-split-v1",
    "chapter": "chapter-glow-v1",
    "content": "content-outline-v1",
    "data": "metric-large-number-v1",
    "comparison": "comparison-columns-v1",
    "process": "process-node-line-v1",
    "quote": "quote-terminal-v1",
    "outro": "outro-brand-v1"
  },
  "allowedLayouts": [
    "cover-split",
    "chapter-glow",
    "content-outline",
    "metric-large-number",
    "comparison-columns",
    "process-node-line",
    "quote-terminal",
    "outro-brand"
  ],
  "allowedAnimations": [
    "fade-rise",
    "stagger-rise",
    "cross-fade"
  ],
  "motion": {
    "intensity": "restrained",
    "enterPreset": "fade-rise",
    "emphasisPreset": "fade-rise",
    "transitionPreset": "cross-fade",
    "enterDurationMs": 420,
    "staggerMs": 0,
    "transitionDurationMs": 420
  },
  "backgrounds": {
    "default": {
      "assetPolicy": "fixed",
      "fit": "cover",
      "focalPoint": {
        "x": 0.5,
        "y": 0.45
      },
      "overlay": {
        "type": "solid",
        "color": "#090d13",
        "opacity": 0.9,
        "direction": "none"
      },
      "blur": 0,
      "tint": 0,
      "contrastMode": "auto",
      "safeArea": {
        "top": 0.1,
        "right": 0.08,
        "bottom": 0.12,
        "left": 0.08
      },
      "fallback": "#090d13"
    },
    "roles": {
      "cover": {
        "inherit": "default"
      },
      "chapter": {
        "inherit": "default"
      },
      "content": {
        "inherit": "default",
        "assetPolicy": "episode-replaceable"
      },
      "data": {
        "inherit": "default"
      },
      "comparison": {
        "inherit": "default"
      },
      "process": {
        "inherit": "default"
      },
      "quote": {
        "inherit": "default"
      },
      "outro": {
        "inherit": "default"
      }
    }
  },
  "subtitle": {
    "position": "bottom-center",
    "style": "caption-rail",
    "fontSize": 36,
    "lineHeight": 1.35,
    "safeAreaBottom": 0.08,
    "maxLines": 2
  },
  "aspectVariants": {
    "16:9": {
      "enabled": true
    },
    "9:16": {
      "enabled": true
    },
    "1:1": {
      "enabled": true
    }
  }
}
