        "height": 45,
        "font": {
          "fontFamily": "Microsoft YaHei",
          "fontSize": 13,
          "color": "#172C2B",
          "bold": false
        }
      }
    },
    {
      "op": "slide_add_shape",
      "payload": {
        "slideId": "$slideId",
        "shape": "rect",
        "x": 72,
        "y": 647,
        "width": 1136,
        "height": 1,
        "fillColor": "#C9D2CC"
      }
    },
    {
      "op": "slide_add_text",
      "payload": {
        "slideId": "$slideId",
        "text": "MONA  /  原生设计示例 · 数据仅作演示",
        "x": 72,
        "y": 661,
        "width": 980,
        "height": 30,
        "font": {
          "fontFamily": "Microsoft YaHei",
          "fontSize": 10,
          "color": "#5B6D68",
          "bold": false
        }
      }
    },
    {
      "op": "slide_add_text",
      "payload": {
        "slideId": "$slideId",
        "text": "01",
        "x": 1160,
        "y": 661,
        "width": 48,
        "height": 30,
        "font": {
          "fontFamily": "Microsoft YaHei",
          "fontSize": 10,
          "color": "#5B6D68",
          "bold": false
