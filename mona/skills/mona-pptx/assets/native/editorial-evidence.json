          "fontFamily": "Microsoft YaHei",
          "fontSize": 21,
          "color": "#172C2B",
          "bold": true
        }
      }
    },
    {
      "op": "slide_add_text",
      "payload": {
        "slideId": "$slideId",
        "text": "标准化交付检查\n减少重复确认与返工",
        "x": 879,
        "y": 446,
        "width": 310,
        "height": 101,
        "font": {
          "fontFamily": "Microsoft YaHei",
          "fontSize": 17,
          "color": "#5B6D68",
          "bold": false
        }
      }
    },
    {
      "op": "slide_add_text",
      "payload": {
        "slideId": "$slideId",
